{
  "detection_rules": [


    {
      "rule_id": "1001",
      "rule_name": "Connection to suspicious RAT ports",
      "enabled": true,
      "packet_level": 15,
      "category": "network",
      "data_type": "net_pro",
      "conditions": [
        { "field": "dport", "operator": "in", "value": [4444, 1337, 5555, 6666, 9999] }
      ]
    },

    {
      "rule_id": "1002",
      "rule_name": "Connection to blacklisted IP",
      "enabled": true,
      "packet_level": 15,
      "category": "network",
      "data_type": "net_pro",
      "conditions": [
        { "field": "daddr", "operator": "in_blacklist", "value": null }
      ]
    },

    {
      "rule_id": "1003",
      "rule_name": "External connection from monitored host",
      "enabled": true,
      "packet_level": 1,
      "category": "network",
      "data_type": "net_pro",
      "conditions": [
        { "field": "daddr", "operator": "is_external", "value": true }
      ]
    },

    {
      "rule_id": "2001",
      "rule_name": "Suspicious shell spawned",
      "enabled": true,
      "packet_level": 15,
      "category": "process",
      "data_type": "net_pro",
      "conditions": [
        { "field": "comm", "operator": "in", "value": ["bash", "sh", "zsh"] }
      ]
 
    },

    {
      "rule_id": "2002",
      "rule_name": "Process executed from temporary directory",
      "enabled": true,
      "packet_level": 10,
      "category": "process",
      "data_type": "net_pro",
      "conditions": [
        { "field": "filename", "operator": "regex", "value": "\\/(tmp|var\\/tmp)\\/" }
      ]
    },

    {
      "rule_id": "2003",
      "rule_name": "High privilege process making external connection",
      "enabled": true,
      "packet_level": 10,
      "category": "combo",
      "data_type": "net_pro",
      "conditions": [
        { "field": "uid", "operator": "in", "value": [0] },
        { "field": "daddr", "operator": "is_external", "value": true }
      ]
    },

    {
      "rule_id": "3001",
      "rule_name": "Port scanning detection",
      "enabled": true,
      "packet_level": 10,
      "category": "network",
      "data_type": "net_pro",
      "conditions": [
        { "field": "protocol", "operator": "equals", "value": 6 }
      ],
      "threshold": {
        "count": 20,
        "window_seconds": 30,
        "group_by": ["saddr"]
      }
    },

    {
      "rule_id": "3002",
      "rule_name": "Brute force connection attempt",
      "enabled": true,
      "packet_level": 10,
      "category": "network",
      "data_type": "net_pro",
      "conditions": [
        { "field": "protocol", "operator": "equals", "value": 6 }
      ],
      "threshold": {
        "count": 10,
        "window_seconds": 60,
        "group_by": ["saddr", "dport"]
      }
    },

    {
      "rule_id": "3003",
      "rule_name": "Rapid process creation (possible fork bomb)",
      "enabled": true,
      "packet_level": 15,
      "category": "process",
      "data_type": "net_pro",
      "conditions": [],
      "threshold": {
        "count": 30,
        "window_seconds": 10,
        "group_by": ["ppid"]
      }
    },


    {
      "rule_id": "4001",
      "rule_name": "SSH failed login attempt",
      "enabled": true,
      "packet_level": 5,
      "category": "auth",
      "data_type": "log_monitoring",
      "conditions": [
        { "field": "action", "operator": "contains", "value": "Failed password" }
      ]
    },

    {
      "rule_id": "4002",
      "rule_name": "SSH brute force attack",
      "enabled": true,
      "packet_level": 10,
      "category": "auth",
      "data_type": "log_monitoring",
      "conditions": [
        { "field": "action", "operator": "contains", "value": "Failed password" }
      ],
      "threshold": {
        "count": 8,
        "window_seconds": 60,
        "group_by": ["src_ip"]
      }
    },



    {
      "rule_id": "5001",
      "rule_name": "Critical system file modified",
      "enabled": true,
      "packet_level": 15,
      "category": "fim",
      "data_type": "file_integrity",
      "conditions": [
        { "field": "file", "operator": "in", "value": ["/etc/passwd", "/etc/shadow", "/etc/sudoers"] },
        { "field": "event", "operator": "equals", "value": "MODIFIED" }
      ]
    },

    {
      "rule_id": "5002",
      "rule_name": "Critical system file deleted",
      "enabled": true,
      "packet_level": 15,
      "category": "fim",
      "data_type": "file_integrity",
      "conditions": [
        { "field": "file", "operator": "regex", "value": "^\\/etc\\/" },
        { "field": "event", "operator": "equals", "value": "DELETED" }
      ]
    },


    {
      "rule_id": "6001",
      "rule_name": "Critical vulnerability detected (CVSS >= 9)",
      "enabled": true,
      "packet_level": 15,
      "category": "vuln",
      "data_type": "software_list",
      "conditions": [
        { "field": "cve_id", "operator": "is_not_null", "value": null },
        { "field": "cvss_score", "operator": "gte", "value": 9.0 }
      ]

    }
  ]
}